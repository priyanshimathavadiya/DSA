
#include<stdio.h>

int main()
{
    char infix[20], stack[20], postfix[20];
    int i, top=-1, j=0;

    printf("Enter infix: ");
    scanf("%s",infix);

    for(i=0;infix[i]!='\0';i++)
    {
        if(infix[i]>='A' && infix[i]<='Z')
            postfix[j++]=infix[i];

        else if(infix[i]=='+' || infix[i]=='-' ||
                infix[i]=='*' || infix[i]=='/')
        {
            while(top!=-1 && stack[top]!='(')
                postfix[j++]=stack[top--];

            stack[++top]=infix[i];
        }
        else if(infix[i]=='(')
            stack[++top]=infix[i];

        else if(infix[i]==')')
        {
            while(top!=-1 && stack[top]!='(')
                postfix[j++]=stack[top--];
            top--;
        }
    }

    while(top!=-1)
        postfix[j++]=stack[top--];

    postfix[j]='\0';

    printf("Suffix = %s",postfix);

    return 0;
}
